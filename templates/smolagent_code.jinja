from __future__ import annotations

from dataclasses import dataclass, field
from typing import Callable, Dict, List, Optional

from smolagents import InferenceClientModel, Tool, ToolCallingAgent


DEFAULT_MODEL = InferenceClientModel()


class PromptTool(Tool):
    """Adapter that turns a BaseTool into a smolagents Tool."""

    def __init__(self, base_tool: "BaseTool") -> None:
        self.base_tool = base_tool
        super().__init__()

    name = "prompt_tool"
    description = "Base prompt-backed tool"
    inputs = {"input_text": {"type": "string", "description": "User tool input"}}
    output_type = "string"

    def forward(self, input_text: str) -> str:
        return self.base_tool.run(input_text)


@dataclass
class BaseTool:
    key: str
    name: str
    description: str
    system_prompt: str
    function_body: Optional[Callable[[str], str]] = None
    model: InferenceClientModel = DEFAULT_MODEL

    def run(self, user_input: str, *args, **kwargs) -> str:
        if self.function_body is not None:
            return str(self.function_body(user_input, *args, **kwargs))

        prompt = (
            f"System Instructions:\n{self.system_prompt}\n\n"
            f"User Input:\n{user_input}\n\n"
            "Return only the final answer for this tool."
        )
        return str(self.model(prompt))

    def as_smol_tool(self) -> Tool:
        class _RuntimePromptTool(PromptTool):
            name = self.key
            description = self.description

        return _RuntimePromptTool(self)


@dataclass
class BaseAgent:
    key: str
    name: str
    description: str
    system_prompt: str
    tools: Dict[str, BaseTool] = field(default_factory=dict)
    model: InferenceClientModel = DEFAULT_MODEL
    max_steps: int = 8

    def _build_runtime_agent(self) -> ToolCallingAgent:
        smol_tools: List[Tool] = [tool.as_smol_tool() for tool in self.tools.values()]
        return ToolCallingAgent(
            tools=smol_tools,
            model=self.model,
            max_steps=self.max_steps,
            instructions=self.system_prompt,
            final_answer_checks=[lambda answer: len(str(answer).strip()) > 0],
        )

    def run(self, user_input: str) -> str:
        runtime_agent = self._build_runtime_agent()
        return str(runtime_agent.run(user_input))


